# ==============================================================================
# Lead Hunter Platform — .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
/.pnp
.pnp.js
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------------------------------------------
# 2. Next.js & Frontend Build Outputs
# ------------------------------------------------------------------------------
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------------------------
# 3. Python Virtual Environments & Caches
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
agent-service/.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg

# Testing & Linting Caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 4. Local SQLite Databases & Data Dumps
# ------------------------------------------------------------------------------
# SQLite database files & WAL journals
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# Local storage folders
data/
agent-service/data/

# Temporary scraper test dumps & export caches
test_output*.json
debug_*.json
gmaps_scrape_*.json
places_scrape_*.json
*copy.json

# ------------------------------------------------------------------------------
# 5. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
agent-service/.env
api_key.txt
*api_key*
*apikey*
*secret*
*.pem
*.key
*.cert


# Retain example config templates
!.env.example
!agent-service/.env.example

# ------------------------------------------------------------------------------
# 6. Logs & Debugging
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 7. OS & IDE Metadata
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor artifacts
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.claude/

# Sandbox staging leftover
mnt/
