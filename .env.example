# --- Next.js app ---
# The agent now runs as a separate Python (FastAPI) service. Point the
# Next.js API route at it. Locally: "npm run dev" in one terminal,
# "uvicorn app.main:app --reload" in agent-service/ in another.
AGENT_SERVICE_URL=http://127.0.0.1:8000

# Where the SQLite database lives (leads + campaigns). Defaults to
# ./data/leadhunt.db inside the project if unset. Use ":memory:" in tests.
# DATABASE_PATH=./data/leadhunt.db

# Resend is only used when you actually send email from the UI.
RESEND_API_KEY=re_xxx

# OpenRouter (optional if using external LLM instead of Ollama)
# OPENROUTER_API_KEY=sk-or-v1-xxx

# --- WhatsApp API Options (Optional: if unset, falls back to wa.me click-to-chat links) ---
# Meta WhatsApp Cloud API:
# WHATSAPP_CLOUD_TOKEN=EAAG...
# WHATSAPP_PHONE_NUMBER_ID=10065...
# UltraMsg API:
# ULTRAMSG_INSTANCE_ID=instance1234
# ULTRAMSG_TOKEN=xyz123...
# Twilio WhatsApp API:
# TWILIO_ACCOUNT_SID=ACxxx...
# TWILIO_AUTH_TOKEN=xxx...
# TWILIO_WHATSAPP_NUMBER=+14155238886

# The Google Places API key is NOT set here — each user enters their own in
# the UI per search (see README "Packaging this to sell").

# --- Python agent service (agent-service/.env) ---
# These live on the agent service side, not Next.js. No API key needed —
# the agent drafts with a local Ollama model:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
